{
  "name": "google-health-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server for the Google Health API, hosted on Cloudflare Workers with OAuth",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:local": "wrangler deploy -c wrangler.local.jsonc",
    "types": "wrangler types",
    "format": "oxfmt --write .",
    "lint": "oxlint",
    "check": "oxfmt --check . && oxlint && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@modelcontextprotocol/client": "^2.4.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=24"
  }
}
